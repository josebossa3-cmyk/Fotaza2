extends ../layout

block content
  .container.py-4
    .d-flex.flex-wrap.align-items-center.justify-content-between.gap-3.mb-4
      div
        h1.h3.fw-bold.mb-1
          i.bi.bi-shield-shaded.text-warning.me-2
          | Lista de Trabajo — Validador de Contenidos
        p.text-muted.small.mb-0 Gestión de publicaciones denunciadas por la comunidad según normativas del TPI.
      span.badge.bg-dark.border.p-2
        i.bi.bi-person-badge.me-1
        | Perfil Validador: #{currentUser ? currentUser.nombre : 'Validador'}

    //- Tarjetas de métricas
    .row.g-3.mb-4
      .col-6.col-md-3
        .card.border-0.shadow-sm.h-100
          .card-body.p-3
            .d-flex.align-items-center.justify-content-between
              div
                p.text-muted.small.mb-0 En Revisión
                h3.fw-bold.mb-0= stats.totalEnRevision
              .rounded-circle.bg-warning.bg-opacity-10.p-3.text-warning
                i.bi.bi-flag-fill.fs-4
      .col-6.col-md-3
        .card.border-0.shadow-sm.h-100
          .card-body.p-3
            .d-flex.align-items-center.justify-content-between
              div
                p.text-muted.small.mb-0 >3 Denuncias (Prioritarias)
                h3.fw-bold.text-danger.mb-0= stats.totalPrioritarias
              .rounded-circle.bg-danger.bg-opacity-10.p-3.text-danger
                i.bi.bi-exclamation-triangle-fill.fs-4
      .col-6.col-md-3
        .card.border-0.shadow-sm.h-100
          .card-body.p-3
            .d-flex.align-items-center.justify-content-between
              div
                p.text-muted.small.mb-0 Publicaciones Bajadas
                h3.fw-bold.mb-0= stats.totalBajadas
              .rounded-circle.bg-secondary.bg-opacity-10.p-3.text-secondary
                i.bi.bi-x-octagon-fill.fs-4
      .col-6.col-md-3
        .card.border-0.shadow-sm.h-100
          .card-body.p-3
            .d-flex.align-items-center.justify-content-between
              div
                p.text-muted.small.mb-0 Cuentas Inactivadas
                h3.fw-bold.text-danger.mb-0= stats.totalInactivos
              .rounded-circle.bg-dark.bg-opacity-10.p-3.text-dark
                i.bi.bi-person-x-fill.fs-4

    
    .alert.alert-secondary.border-0.shadow-sm.py-2.px-3.mb-4
      .d-flex.align-items-center.gap-2
        i.bi.bi-info-circle-fill.text-primary
        small
          strong Reglas de Moderación:
          |  Las publicaciones con más de 3 denuncias de diferentes usuarios ingresan con prioridad a tu lista de trabajo. Si un usuario llega a 3 publicaciones "bajadas", el sistema inactivará automáticamente su cuenta.

    if !publicaciones || !publicaciones.length
      .card.border-0.shadow-sm.text-center.py-5
        .card-body
          i.bi.bi-check-circle-fill.display-4.text-success.mb-3
          h4.fw-bold ¡Todo en orden!
          p.text-muted.mb-0 No hay publicaciones con denuncias activas pendientes de revisión.
    else
      .d-flex.flex-column.gap-4
        each pub in publicaciones
          .card.border-0.shadow-sm(class=pub.es_prioritaria ? 'border-start border-danger border-4' : '')
            .card-header.bg-transparent.d-flex.flex-wrap.align-items-center.justify-content-between.gap-2.py-3
              .d-flex.align-items-center.gap-2
                if pub.es_prioritaria
                  span.badge.bg-danger.text-white
                    i.bi.bi-exclamation-triangle-fill.me-1
                    | PRIORITARIA (>3 Denuncias)
                else
                  span.badge.bg-warning.text-dark
                    i.bi.bi-flag.me-1
                    | #{pub.denuncias_count} denuncia#{pub.denuncias_count !== 1 ? 's' : ''}
                span.fw-bold= pub.titulo
                span.text-muted.small · Publicado el #{new Date(pub.create_timestamp).toLocaleDateString('es-AR')}
              
              .d-flex.align-items-center.gap-2
                span.small.text-muted Autor:
                strong.small= pub.autor_nombre
                if pub.autor_bajas_count > 0
                  span.badge.bg-danger.bg-opacity-10.text-danger.small
                    | #{pub.autor_bajas_count}/3 bajas
                else
                  span.badge.bg-success.bg-opacity-10.text-success.small 0 bajas

            .card-body
              .row.g-3
                .col-md-3.col-lg-2
                  img.rounded.w-100(
                    src=pub.url
                    alt=pub.titulo
                    style="max-height: 140px; object-fit: cover;"
                  )
                .col-md-9.col-lg-10
                  if pub.descripcion
                    p.small.text-muted.mb-2
                      strong Descripción: 
                      = pub.descripcion
                  p.small.mb-2
                    strong Licencia: 
                    if pub.licencia === 'copyright'
                      span.badge.bg-warning.text-dark © Copyright
                    else
                      span.badge.bg-success Libre uso
                  
                  //- Detalle de las denuncias recibidas
                  h6.small.fw-bold.mt-3.mb-2
                    i.bi.bi-chat-left-text.me-1
                    | Denuncias registradas (#{pub.detalles_denuncias.length}):
                  .table-responsive
                    table.table.table-sm.table-bordered.align-middle.small.mb-3
                      thead.table-light
                        tr
                          th Motivo
                          th Justificación
                          th Denunciante
                          th Fecha
                      tbody
                        each d in pub.detalles_denuncias
                          tr
                            td.fw-semibold.text-danger= d.motivo
                            td= d.descripcion || 'Sin justificación adicional'
                            td= d.denunciante_nombre
                            td= new Date(d.fecha).toLocaleDateString('es-AR')

                  //- Acciones del validador
                  .d-flex.flex-wrap.align-items-center.gap-2.pt-2.border-top
                    form(method="POST" action=`/validador/publicaciones/${pub.id}/bajar` onsubmit="return confirm('¿Confirmas que deseas DAR DE BAJA esta publicación? Si el autor acumula 3 bajas, su cuenta será desactivada.');")
                      button.btn.btn-danger.btn-sm(type="submit")
                        i.bi.bi-slash-circle.me-1
                        | Dar de baja publicación
                    
                    form(method="POST" action=`/validador/publicaciones/${pub.id}/desestimar` onsubmit="return confirm('¿Deseas desestimar estas denuncias? La publicación continuará visible.');")
                      button.btn.btn-outline-secondary.btn-sm(type="submit")
                        i.bi.bi-check2-circle.me-1
                        | Desestimar denuncias

                    a.btn.btn-outline-primary.btn-sm(href=`/publicaciones/${pub.id}` target="_blank")
                      i.bi.bi-box-arrow-up-right.me-1
                      | Ver en la app
