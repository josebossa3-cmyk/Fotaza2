extends ../layout

block content
  .container.py-4

    .row.g-4
      //- Columna izquierda imagen
      .col-lg-8
        .card.border-0.shadow-sm
          img.card-img-top.rounded(
            src=publicacion.ruta_archivo
            alt=publicacion.titulo
            style="max-height: 600px; object-fit: contain; background: #f8f9fa;"
          )

      //- Columna derecha info
      .col-lg-4
        .d-flex.flex-column.gap-3

          //- Autor
          .d-flex.align-items-center.gap-2
            if publicacion.autor_foto
              img.rounded-circle(
                src=publicacion.autor_foto
                style="width:40px; height:40px; object-fit:cover;"
              )
            else
              .rounded-circle.bg-secondary.d-flex.align-items-center.justify-content-center(
                style="width:40px; height:40px;"
              )
                span.text-white.small= publicacion.autor_nombre.charAt(0).toUpperCase()
            div
              a.fw-semibold.text-decoration-none.text-dark(
                href=`/usuarios/${publicacion.autor_id}`
              )= publicacion.autor_nombre
              p.text-muted.small.mb-0= publicacion.create_timestamp.toLocaleDateString('es-AR')

          //- Título y descripción
          div
            h4.fw-bold= publicacion.titulo
            if publicacion.descripcion
              p.text-muted= publicacion.descripcion

          //- Etiquetas
          if publicacion.etiquetas && publicacion.etiquetas.length
            .d-flex.flex-wrap.gap-1
              each tag in publicacion.etiquetas
                span.badge.bg-light.text-dark.border= tag

          //- Licencia
          .d-flex.align-items-center.gap-2
            if publicacion.licencia === 'copyright'
              span.badge.bg-warning.text-dark © Copyright
            else
              span.badge.bg-success Libre uso

          hr

          //- Valoraciones
          .d-flex.flex-column.gap-1
            .d-flex.align-items-center.gap-2
              span.fw-semibold Valoración:
              span.fs-5.text-warning
                - for (let i = 1; i <= 5; i++)
                  if i <= Math.round(publicacion.valoracion_promedio)
                    | ★
                  else
                    | ☆
              span.text-muted.small= `${publicacion.valoracion_promedio} (${publicacion.valoracion_cantidad} votos)`

            //- Formulario de votación (solo si está logueado y no es el autor y no votó)
            if user && user.id !== publicacion.autor_id && !yaValoro
              .mt-1
                p.small.text-muted.mb-1 Tu valoración:
                .d-flex.gap-1#estrellas-form
                  each val in [1,2,3,4,5]
                    button.btn.btn-sm.btn-outline-warning.estrella-btn(
                      type="button"
                      data-valor=val
                      data-id=publicacion.id
                    ) ★
            else if yaValoro
              p.small.text-muted Ya valoraste esta publicación con #{miValoracion} ★

          hr

          //- Botón Guardar
          if user && user.id !== publicacion.autor_id
            button.btn.btn-outline-primary.w-100.mb-2(
              type="button"
              id="btn-guardar"
              data-id=publicacion.id
            )
              i.bi.bi-bookmark.me-2
              | Guardar

          //- Botón Me Interesa
          if user && user.id !== publicacion.autor_id
            button.btn.btn-primary.w-100.mb-2(
              type="button"
              id="btn-me-interesa"
              data-id=publicacion.id
            )
              i.bi.bi-chat-dots.me-2
              | Me interesa

          //Botón Denunciar Publicación 
          if user && user.id !== publicacion.autor_id
            if yaDenuncioPub
              .badge.bg-secondary.text-white.w-100.py-2.mb-2
                i.bi.bi-flag-fill.me-1
                | Ya denunciaste esta publicación
            else
              button.btn.btn-outline-danger.w-100.mb-2#btn-abrir-denuncia(
                type="button"
                data-bs-toggle="modal"
                data-bs-target="#modalDenunciaPub"
              )
                i.bi.bi-flag.me-2
                | Denunciar publicación

          //Aviso si la publicación tiene denuncias 
          if user && user.id === publicacion.autor_id && tieneDenuncias
            .alert.alert-warning.small.mb-2
              i.bi.bi-shield-exclamation.me-1
              strong Bloqueada para edición: 
              | Esta publicación tiene denuncias activas en revisión por lo que no puede ser modificada.

          //- Cerrar comentarios 
          if user && user.id === publicacion.autor_id
            form(method="POST" action=`/publicaciones/${publicacion.id}/cerrar-comentarios`)
              button.btn.btn-outline-secondary.w-100.btn-sm(type="submit")
                if publicacion.comentarios_abiertos
                  | Cerrar comentarios
                else
                  | Comentarios cerrados

    //- Sección de comentarios
    .row.mt-4
      .col-lg-8

        h5.fw-bold.mb-3 Comentarios (#{publicacion.comentarios_count})

        //- Formulario nuevo comentario
        if user && publicacion.comentarios_abiertos
          form.mb-4(method="POST" action=`/publicaciones/${publicacion.id}/comentar`)
            .input-group
              input.form-control(
                type="text"
                name="contenido"
                placeholder="Escribí un comentario..."
                required
              )
              button.btn.btn-dark(type="submit") Enviar
        else if !publicacion.comentarios_abiertos
          .alert.alert-secondary.small Los comentarios están cerrados.
        else if !user
          .alert.alert-info.small
            | 
            a(href="/auth/login") Iniciá sesión
            |  para comentar.

        // Sección organizada de comentarios denunciados 
        if user && user.id === publicacion.autor_id && comentariosDenunciadosDetalle && comentariosDenunciadosDetalle.length
          .card.border-warning.shadow-sm.mb-4
            .card-header.bg-warning.bg-opacity-10.d-flex.align-items-center.justify-content-between.py-2
              span.fw-bold.small.text-dark
                i.bi.bi-shield-exclamation.text-warning.me-2
                | Comentarios denunciados por la comunidad (#{comentariosDenunciadosDetalle.length})
              span.badge.bg-warning.text-dark Requiere revisión
            .card-body.p-0
              .table-responsive
                table.table.table-sm.table-hover.align-middle.mb-0.small
                  thead.table-light
                    tr
                      th Comentario
                      th Motivo
                      th Justificación
                      th Denunciante
                      th Acción
                  tbody
                    each cd in comentariosDenunciadosDetalle
                      tr
                        td.fw-semibold= cd.comentario_texto
                        td.text-danger= cd.motivo
                        td.text-muted= cd.descripcion || 'Sin detalle'
                        td= cd.denunciante_nombre
                        td
                          button.btn.btn-outline-danger.btn-sm.py-0(
                            type="button"
                            onclick=`eliminarComentario(${cd.comentario_id})`
                            title="Eliminar este comentario denunciado"
                          )
                            i.bi.bi-trash.me-1
                            | Borrar

        //- Lista de comentarios
        if comentarios.length === 0
          p.text-muted.small Todavía no hay comentarios.
        else
          each comentario in comentarios
            .d-flex.gap-2.mb-3(id=`comentario-${comentario.id}`)
              if comentario.autor_foto
                img.rounded-circle(
                  src=comentario.autor_foto
                  style="width:35px; height:35px; object-fit:cover;"
                )
              else
                .rounded-circle.bg-secondary.d-flex.align-items-center.justify-content-center(
                  style="width:35px; height:35px; flex-shrink:0;"
                )
                  span.text-white.small= comentario.autor_nombre.charAt(0).toUpperCase()
              div.flex-grow-1
                .d-flex.justify-content-between.align-items-center
                  div
                    span.fw-semibold.small= comentario.autor_nombre
                    if comentario.denuncias_count > 0
                      span.badge.bg-danger.bg-opacity-10.text-danger.ms-2.small(style="font-size:0.7rem;")
                        i.bi.bi-flag-fill.me-1
                        | #{comentario.denuncias_count} denuncia#{comentario.denuncias_count !== 1 ? 's' : ''}
                  .d-flex.align-items-center.gap-2
                    span.text-muted.small= new Date(comentario.fecha).toLocaleDateString('es-AR')
                    if user && user.id !== comentario.usuario_id
                      button.btn.btn-link.text-muted.p-0(
                        type="button"
                        title="Denunciar comentario"
                        onclick=`abrirModalDenunciaComentario(${comentario.id})`
                      )
                        i.bi.bi-flag
                    if user && (user.id === publicacion.autor_id || user.id === comentario.usuario_id)
                      button.btn.btn-link.text-danger.p-0(
                        type="button"
                        title="Eliminar comentario"
                        onclick=`eliminarComentario(${comentario.id})`
                      )
                        i.bi.bi-trash
                p.mb-0.small= comentario.contenido

    // Modal de Denuncia de Publicación
    .modal.fade#modalDenunciaPub(tabindex="-1" aria-labelledby="modalDenunciaPubLabel" aria-hidden="true")
      .modal-dialog
        .modal-content
          .modal-header
            h5.modal-title#modalDenunciaPubLabel
              i.bi.bi-flag-fill.text-danger.me-2
              | Denunciar publicación
            button.btn-close(type="button" data-bs-dismiss="modal" aria-label="Cerrar")
          .modal-body
            form#formDenunciaPub
              .mb-3
                label.form-label.fw-semibold(for="motivoPub") Motivo de la denuncia *
                select.form-select#motivoPub(required)
                  option(value="" disabled selected) Seleccioná un motivo...
                  option(value="Contenido inapropiado u ofensivo") Contenido inapropiado u ofensivo
                  option(value="Violación de derechos de autor (Copyright)") Violación de derechos de autor (Copyright)
                  option(value="Spam o publicidad engañosa") Spam o publicidad engañosa
                  option(value="Violencia o incitación al odio") Violencia o incitación al odio
                  option(value="Otro motivo") Otro motivo
              .mb-3
                label.form-label.fw-semibold(for="descPub") Justificación o descripción *
                textarea.form-control#descPub(rows="3" required placeholder="Explicá detalladamente por qué denunciás esta imagen...")
              .alert.alert-info.small.mb-0
                i.bi.bi-info-circle.me-1
                | Tu denuncia será revisada por el Validador de Contenidos. Si acumula más de 3 denuncias, será evaluada con prioridad.
          .modal-footer
            button.btn.btn-secondary.btn-sm(type="button" data-bs-dismiss="modal") Cancelar
            button.btn.btn-danger.btn-sm#btnEnviarDenunciaPub(type="button") Enviar denuncia

    //Modal de Denuncia de Comentario
    .modal.fade#modalDenunciaComentario(tabindex="-1" aria-labelledby="modalDenunciaComentarioLabel" aria-hidden="true")
      .modal-dialog
        .modal-content
          .modal-header
            h5.modal-title#modalDenunciaComentarioLabel
              i.bi.bi-flag-fill.text-danger.me-2
              | Denunciar comentario
            button.btn-close(type="button" data-bs-dismiss="modal" aria-label="Cerrar")
          .modal-body
            form#formDenunciaComentario
              input(type="hidden" id="comentarioIdDenunciar")
              .mb-3
                label.form-label.fw-semibold(for="motivoComentario") Motivo *
                select.form-select#motivoComentario(required)
                  option(value="" disabled selected) Seleccioná un motivo...
                  option(value="Lenguaje ofensivo o insultos") Lenguaje ofensivo o insultos
                  option(value="Spam o publicidad") Spam o publicidad
                  option(value="Acoso o difamación") Acoso o difamación
                  option(value="Otro motivo") Otro motivo
              .mb-3
                label.form-label.fw-semibold(for="descComentario") Justificación
                textarea.form-control#descComentario(rows="2" placeholder="Opcional...")
          .modal-footer
            button.btn.btn-secondary.btn-sm(type="button" data-bs-dismiss="modal") Cancelar
            button.btn.btn-danger.btn-sm#btnEnviarDenunciaComentario(type="button") Denunciar

block append scripts
  script.
    // Envío de denuncia de publicación
    const btnEnviarPub = document.getElementById('btnEnviarDenunciaPub');
    if (btnEnviarPub) {
      btnEnviarPub.addEventListener('click', async () => {
        const motivo = document.getElementById('motivoPub').value;
        const descripcion = document.getElementById('descPub').value;
        if (!motivo || !descripcion.trim()) {
          alert('Selecciona un motivo y explica la denuncia.');
          return;
        }
        try {
          const res = await fetch('/publicaciones/#{publicacion.id}/denunciar', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ motivo, descripcion })
          });
          const data = await res.json();
          alert(data.message);
          if (data.success) {
            window.location.reload();
          }
        } catch (err) {
          console.error(err);
          alert('Error al enviar la denuncia.');
        }
      });
    }

    // Modal de denuncia de comentario
    let modalComentarioBs = null;
    function abrirModalDenunciaComentario(comentarioId) {
      document.getElementById('comentarioIdDenunciar').value = comentarioId;
      if (!modalComentarioBs) {
        modalComentarioBs = new bootstrap.Modal(document.getElementById('modalDenunciaComentario'));
      }
      modalComentarioBs.show();
    }

    const btnEnviarComentario = document.getElementById('btnEnviarDenunciaComentario');
    if (btnEnviarComentario) {
      btnEnviarComentario.addEventListener('click', async () => {
        const comentarioId = document.getElementById('comentarioIdDenunciar').value;
        const motivo = document.getElementById('motivoComentario').value;
        const descripcion = document.getElementById('descComentario').value;
        if (!motivo) {
          alert('Selecciona un motivo.');
          return;
        }
        try {
          const res = await fetch(`/comentarios/${comentarioId}/denunciar`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ motivo, descripcion })
          });
          const data = await res.json();
          alert(data.message);
          if (data.success) {
            window.location.reload();
          }
        } catch (e) {
          console.error(e);
          alert('Error al denunciar comentario.');
        }
      });
    }

    // Eliminación de comentario 
    async function eliminarComentario(comentarioId) {
      if (!confirm('¿Seguro que deseas eliminar este comentario?')) return;
      try {
        const res = await fetch(`/comentarios/${comentarioId}/eliminar`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' }
        });
        const data = await res.json();
        alert(data.message);
        if (data.success) {
          window.location.reload();
        }
      } catch (err) {
        console.error(err);
        alert('Error al eliminar comentario.');
      }
    }
